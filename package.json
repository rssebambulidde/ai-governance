{
  "name": "ai-governance",
  "version": "1.0.0",
  "description": "Enterprise AI Governance & Safety Engineering Portfolio — NIST AI RMF 1.0 (NIST AI 100-1) operationalization, TEVV evaluations, and interactive web suite.",
  "main": "tools/ai-impact-assessment/app.js",
  "scripts": {
    "serve": "python -m http.server 8080 --directory tools/ai-impact-assessment",
    "serve:node": "npx serve tools/ai-impact-assessment",
    "deploy": "npm run deploy:production",
    "deploy:preview": "npx wrangler pages deploy tools/ai-impact-assessment --project-name=governance --branch=development",
    "deploy:production": "npx wrangler pages deploy tools/ai-impact-assessment --project-name=governance --branch=main",
    "db:migrate:preview": "npx wrangler d1 execute govern-hub-preview --remote --file migrations/0001-create-ai-inventory.sql",
    "db:migrate:production": "npx wrangler d1 execute govern-hub-production --remote --file migrations/0001-create-ai-inventory.sql",
    "db:migrate:workspaces:preview": "npx wrangler d1 execute govern-hub-preview --remote --file migrations/0002-multi-company-workspaces.sql",
    "db:migrate:workspaces:production": "npx wrangler d1 execute govern-hub-production --remote --file migrations/0002-multi-company-workspaces.sql",
    "db:migrate:modules:preview": "npx wrangler d1 execute govern-hub-preview --remote --file migrations/0003-organization-module-data.sql",
    "db:migrate:modules:production": "npx wrangler d1 execute govern-hub-production --remote --file migrations/0003-organization-module-data.sql",
    "db:execute:preview": "npx wrangler d1 execute govern-hub-preview --remote",
    "db:execute:production": "npx wrangler d1 execute govern-hub-production --remote"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rssebambulidde/ai-governance.git"
  },
  "keywords": [
    "ai-governance",
    "nist-ai-rmf",
    "nist-ai-100-1",
    "responsible-ai",
    "ai-safety",
    "tevv",
    "ai-risk-management",
    "ai-impact-assessment",
    "cloudflare-pages",
    "samabrains"
  ],
  "author": "Robert Ssebambulidde <rssebambulidde@gmail.com> (https://samabrains.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rssebambulidde/ai-governance/issues"
  },
  "homepage": "https://govern.samabrains.com",
  "dependencies": {
    "md-to-pdf": "^5.2.5"
  },
  "allowScripts": {
    "puppeteer@25.14.0": true
  }
}
